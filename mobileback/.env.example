# mobileback — 山途可落地 Go 后端
#
# 默认本地用 SQLite（无需 Docker），生产可换 Postgres（见 docker-compose.yml）。
#
# 启动：
#   make seed
#   make run
#
# API: http://localhost:9092/api/v1
# 演示登录验证码: 1234
#
# Client:
#   EXPO_PUBLIC_BACKEND_BASE_URL=http://localhost:9092

PORT=9092
DATABASE_URL=sqlite://./data/mountpath.db
JWT_SECRET=mountpath-dev-secret-change-me
DEMO_OTP=1234
PUBLIC_BASE_URL=http://127.0.0.1:9092
UPLOAD_DIR=./data/uploads
# WEATHER_LAT=30.25
# WEATHER_LNG=118.15
# MAP_TILE_CDN=https://your-tile-cdn.example/mountpath
NOTIFY_MODE=demo
