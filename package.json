{
  "name": "expo-express-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "bash scripts/dev_run.sh",
    "dev:mobileback": "bash scripts/dev_run.sh",
    "dev:api": "cd mobileback && make run",
    "dev:client": "EXPO_PUBLIC_BACKEND_BASE_URL=http://127.0.0.1:9092 pnpm --filter expo-app start",
    "dev:admin": "pnpm --filter mobilemange dev",
    "dev:coze-legacy": "echo '已弃用：.cozeproj 仍会启动已删除的 Express :9091；请用 pnpm dev' && exit 1",
    "build": "bash scripts/legacy-coze-blocked.sh",
    "start": "bash scripts/dev_run.sh",
    "preinstall": "npx only-allow pnpm",
    "lint:client": "npm run lint --prefix ./client",
    "lint:admin": "pnpm --filter mobilemange lint",
    "lint:all": "npm run lint --prefix ./client; pnpm lint:admin",
    "validate": "pnpm lint:client"
  },
  "dependencies": {},
  "devDependencies": {},
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.2"
    },
    "patchedDependencies": {
     
    }
  }
}
